#!/usr/bin/env bash
# Set up the coap_client_for_esphome development environment.
#
# Creates venv/ containing:
#   - pytest and all test dependencies
#   - homeassistant and validation packages (for hassfest / HACS hooks)
#   - pre-commit (wired to git hooks on completion)
#
# Run once after cloning, or to rebuild after deleting venv/.
# Requires ~/dev/core (HA core repo) for hassfest to work at commit time, e.g.
#   git clone --depth 1 --branch <latest release> https://github.com/home-assistant/core.git ~/dev/core
# Re-run this script after moving ~/dev/core to another release.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
UV="${HOME}/.local/bin/uv"

# ---------------------------------------------------------------------------
# 1. Ensure uv is available
# ---------------------------------------------------------------------------
echo "==> Checking for uv..."
if ! command -v uv &>/dev/null && [ ! -x "${UV}" ]; then
    echo "    Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
UV="$(command -v uv 2>/dev/null || echo "${UV}")"

# ---------------------------------------------------------------------------
# 2. Create venv/ and install everything
# ---------------------------------------------------------------------------
echo "==> Creating venv/..."
"${UV}" venv "${REPO_ROOT}/venv"

echo "==> Installing test dependencies..."
"${UV}" pip install \
    --python "${REPO_ROOT}/venv/bin/python" \
    -r "${REPO_ROOT}/requirements_tests.txt"

echo "==> Installing validation and pre-commit packages..."
"${UV}" pip install \
    --python "${REPO_ROOT}/venv/bin/python" \
    homeassistant tqdm ruff awesomeversion voluptuous pre-commit

# Since 2026.11, HA core keeps hassfest's shared code in packages/hassfest and refuses to run with a
# ruff older than the one it pins, so install both from the core checkout
HA_CORE="${HOME}/dev/core"
if [ -d "${HA_CORE}/packages/hassfest" ]; then
    echo "==> Installing hassfest from ${HA_CORE}..."
    RUFF_PIN="$(grep -E '^ruff==' "${HA_CORE}/requirements_test_pre_commit.txt" || true)"
    "${UV}" pip install \
        --python "${REPO_ROOT}/venv/bin/python" \
        -e "${HA_CORE}/packages/hassfest" ${RUFF_PIN:+"${RUFF_PIN}"}
elif [ ! -d "${HA_CORE}" ]; then
    echo "    ${HA_CORE} not found: clone HA core there for the hassfest hook"
fi

# ---------------------------------------------------------------------------
# 3. Wire git hooks
# ---------------------------------------------------------------------------
echo "==> Installing git hooks..."
"${REPO_ROOT}/venv/bin/pre-commit" install

echo ""
echo "Done."
echo ""
echo "  Activate:   source venv/bin/activate"
echo "  Run tests:  venv/bin/pytest tests/"
echo "  Lint:       venv/bin/pre-commit run --all-files"
